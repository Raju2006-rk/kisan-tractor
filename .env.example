# KisanTractor environment variables
#
# The app runs out of the box with a server-side JSON store, so no values are
# required for the demo. Fill these in when you connect a real Supabase project.
#
# 1. Create a project at https://supabase.com
# 2. Run supabase/schema.sql in the SQL editor
# 3. Copy the project URL and keys below
#
# The anon key is safe for the browser (RLS protects the data).
# The service role key must only ever be used on the server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Demo-only. Set to "true" to allow POST /api/demo/reset in a production build.
# Never enable this on a real deployment with real data.
ALLOW_DEMO_RESET=false

# Signs the login session cookie. Set a long random value on Vercel so sessions
# cannot be forged. If unset, the app uses a built-in demo fallback.
SESSION_SECRET=
